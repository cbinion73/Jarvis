# ── LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# ── JARVIS ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
HUGGINGFACE_TOKEN=your_huggingface_token
JARVIS_PLAID_CLIENT_ID=
JARVIS_PLAID_SECRET=
JARVIS_PLAID_ENV=sandbox
JARVIS_PLAID_COUNTRY_CODES=US
JARVIS_PLAID_WEBHOOK_URL=

# ── DATABASE ─────────────────────────────────────────────────────────────
# Compose builds the service database URLs from DB_USER and DB_PASSWORD.
# DB_PASSWORD must stay URL-safe for that form.
DB_USER=your-jarvis-db-user-here
DB_PASSWORD=your-jarvis-db-password-url-safe-here

# ── REDIS ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── CLOUDFLARE ───────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ── GHOSTWRITR ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_random_secret
NEXTAUTH_URL=https://ghostwritr.teambinion.org

# ── STORAGE (Cloudflare R2) ──────────────────────────────────────────────
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET=ghostwritr-assets
